#include <stdio.h>
#include <string.h>
#include <stdlib.h>
struct student{
    char name[20];
    char id[20];
    float score[3];
    float  total[1];
    float average[1];
};
int main(){
   int n=0,i=0,b=0;
    printf("请输入学生人数：");
    scanf("%d",&n);
    struct student *stu=(struct student*)malloc(n*sizeof(struct student));
    for(i=0;i<n;i++){
        scanf("%f %f %f",&stu[i].score[0],&stu[i].score[1],&stu[i].score[2]);
       stu[i].total[0]=stu[i].score[0]+stu[i].score[1]+stu[i].score[2];
       stu[i].average[0]=stu[i].total[0]/3.0;
       if(stu[i].average[0]>=60){
           b++;
       }
    }
    printf("及格人数：%d\n",b);






}
